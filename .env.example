# Etsy Open API v3 application credentials
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# Must exactly match a redirect URI registered in Etsy Developer Portal
ETSY_REDIRECT_URI=http://localhost:3000/auth/etsy/callback

# Optional override. Normally leave blank; it is discovered after OAuth.
ETSY_SHOP_ID=

# Codex cloud: set these as encrypted environment Secrets, never in Git.
# They are generated by the local OAuth flow; do not fill them in this example file.
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_TOKEN_SCOPE=transactions_r listings_r listings_w

# Optional; normally leave unchanged
PORT=3000
